{
  "manifest_version": 3,
  "name": "苔むす森のおしごと便り — bridge",
  "version": "0.1.0",
  "description": "Sends Claude.ai chat activity to the local agent-zoo viewer at http://127.0.0.1:7777.",
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [{
    "matches": ["https://claude.ai/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "background": {
    "service_worker": "background.js"
  }
}
