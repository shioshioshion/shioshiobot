{
  "manifest_version": 3,
  "name": "とここと 経営ダッシュボード — bridge",
  "version": "1.0.0",
  "description": "Claude.ai のチャット活動を、ローカルの「とここと 経営ダッシュボード」(http://127.0.0.1:7777) に送ります。",
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [{
    "matches": ["https://claude.ai/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "background": {
    "service_worker": "background.js"
  }
}
